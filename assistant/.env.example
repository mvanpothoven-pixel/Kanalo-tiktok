# Kopieer naar .env (staat in .gitignore) of zet ze als omgevingsvariabelen op je host.
# Start met:  node --env-file=.env server.mjs

# --- Grok (xAI) — alleen op de server, nooit in de app of HTML ---
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Tokens (lang en willekeurig, bv. `openssl rand -hex 32`) ---
TABLEJOY_TOKEN=        # in de TableJoy-app (alleen data van dat restaurant)
KANALO_TOKEN=          # in de Kanalo-app (alleen data van dat toestel)
OWNER_TOKEN=           # alleen voor jou: werkvloer, alle bedrijfsdata

# --- Kanalo-data: je Kanalo MCP-server (bugrapporten, abonnementen, meldingen) ---
KANALO_MCP_URL=
KANALO_MCP_TOKEN=

# --- Kanalo-reviews: App Store Connect API-sleutel (rol: Customer Support of hoger) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_APP_ID=
ASC_PRIVATE_KEY_PATH=  # pad naar AuthKey_XXXX.p8

# --- TableJoy-reserveringen: jouw backend ---
TABLEJOY_API_URL=
TABLEJOY_API_KEY=
TABLEJOY_RESERVATIONS_PATH=/reservations

# --- Overig ---
PORT=8787
ALLOWED_ORIGINS=       # alleen nodig als de werkvloer niet door deze server zelf wordt geserveerd
RATE_PER_MINUTE=30
